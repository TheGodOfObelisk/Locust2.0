	<xs:element block="#all" final="#all" name="cee">
		<xs:complexType>
			<xs:sequence>
				<xs:element maxOccurs="unbounded" minOccurs="0" ref="event"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="event" type="EventType" />
	<xs:complexType name="EventType">
		<xs:sequence>
			<xs:element ref="profile:host" minOccurs="1" />
			<xs:element ref="profile:pname" minOccurs="1" />
			<xs:element ref="profile:time" minOccurs="1" />
			<xs:any namespace="http://cee.mitre.org/1.0/profile/" processContents="strict" minOccurs="0" maxOccurs="unbounded"></xs:any>
			<xs:element name="native" minOccurs="0" maxOccurs="1">
				<xs:complexType>
					<xs:sequence minOccurs="0" maxOccurs="unbounded">
						<xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />	
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="profile" type="xs:anyURI" />
	</xs:complexType>
	<xs:simpleType name="tag">
    	<xs:restriction base="xs:string">
      		<xs:pattern value=":?[a-zA-Z0-9]{1,32}"/>
      		<xs:whiteSpace value="collapse"/>
    	</xs:restriction>
  	</xs:simpleType>
  	<xs:simpleType name="tag_ext">
	    <xs:restriction base="tag">
    		<xs:pattern value=":.*"/>
    	</xs:restriction>
  	</xs:simpleType>
</xs:schema>
